# --- patient data & anything derived from it never enters git ---
results/
clinical/
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bam.bai
*.cram
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bed.gz
*.tar.gz
*.zip
# reference data
resources/refs/
# secrets
.env
*.token
secrets*.yaml
# python / tooling
__pycache__/
*.pyc
.pytest_cache/
.snakemake/
.streamlit/secrets.toml
.ipynb_checkpoints/
.DS_Store
# allow small example data
!examples/**/*.fastq.gz
!examples/**/*.vcf
!examples/**/*.bed

# fetched at setup time, not redistributed (see docs/licensing.md)
resources/cancer_genes.tsv
resources/cancer_genes.txt
resources/clinvar_*
resources/hotspots*

# conda/env creation logs and generated indexes
logs/
examples/reference/*.fa.*
examples/reference/*.dict
# raw VEP payloads are large and regenerable
results_example/dna/vep.json
results_example/logs/
.snakemake/

# local overrides carrying real paths / identifiers
config/config.local.yaml
